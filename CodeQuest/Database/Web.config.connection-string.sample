<add key="CodeQuestSmtpPort" value="587" />
<add key="CodeQuestSmtpSsl" value="true" />
<add key="CodeQuestResetFromEmail" value="no-reply@example.com" />
<add key="CodeQuestSmtpUsername" value="smtp-user" />
<add key="CodeQuestSmtpPassword" value="smtp-password" />
-->

